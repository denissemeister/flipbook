# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./uploads

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# Your Gmail address and an App Password (not your regular Gmail password).
# To create an App Password: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Database (overridden inside Docker by docker-compose.yml) ─────────────────
DATABASE_URL=postgres://flipbook:flipbook_dev@localhost:5432/flipbook

